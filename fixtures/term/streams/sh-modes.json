        "send": "tput rmcup\r"
      },
      {
        "checkpoint": "tput-rmcup"
      },
      {
        "send": "printf '\\033[?2026hsynchronized\\033[2;1Hframe\\033[?2026l\\n'\r"
      },
      {
        "checkpoint": "sync"
      },
      {
        "send": "printf '\\033[?2004h\\033[?1000h\\033[?1006h\\033[?1004h\\033[?1h\\033=\\033[?25lmodes on\\n'\r"
      },
      {
        "checkpoint": "modes-on"
      },
      {
        "send": "printf '\\033[?2004l\\033[?1000l\\033[?1006l\\033[?1004l\\033[?1l\\033>\\033[?25hmodes off\\n'\r"
      },
      {
        "checkpoint": "modes-off"
      },
      {
        "send": "printf '\\033]0;title zero\\007\\033]2;title two\\033\\\\titled\\n'\r"
      },
      {
        "checkpoint": "titles"
      },
