    "steps": [
      {
        "send": "for c in 30 31 32 33 34 35 36 37 90 91 92 93 94 95 96 97; do printf '\\033[%sm fg%s \\033[0m' $c $c; done; echo\r"
      },
      {
        "checkpoint": "fg16"
      },
      {
        "send": "for c in 40 41 42 43 44 45 46 47 100 101 102 103 104 105 106 107; do printf '\\033[%sm bg%s \\033[0m' $c $c; done; echo\r"
      },
      {
        "checkpoint": "bg16"
      },
      {
        "send": "i=0; while [ $i -lt 256 ]; do printf '\\033[38;5;%sm%3s\\033[48;5;%sm \\033[0m' $i $i $i; i=$((i+1)); done; echo\r"
      },
      {
        "checkpoint": "palette256"
      },
      {
        "send": "i=0; while [ $i -lt 64 ]; do printf '\\033[48;2;%s;%s;%sm \\033[0m' $((i*4)) $((255-i*4)) 128; i=$((i+1)); done; echo\r"
      },
      {
        "send": "printf '\\033[38:2::255:128:0mcolon-rgb\\033[0m \\033[38:5:208mcolon-256\\033[0m \\033[38;2;10;20;30;48;2;200;210;220mboth\\033[39;49m default\\n'\r"
      },
      {
        "checkpoint": "truecolor"
      },
      {
        "send": "printf '\\033[1mbold\\033[22m \\033[2mdim\\033[22m \\033[3mitalic\\033[23m \\033[4munder\\033[24m \\033[21mdouble\\033[24m \\033[4:3mcurly\\033[4:0m \\033[58;2;255;0;0m\\033[4mred-ul\\033[59;24m\\n'\r"
      },
      {
        "send": "printf '\\033[5mblink\\033[25m \\033[7minverse\\033[27m \\033[8mhidden\\033[28m \\033[9mstrike\\033[29m \\033[53mover\\033[55m \\033[1;3;4;7;31;42mall\\033[0m \\033[1;31mbold-red\\033[0m \\033[1;90mbright\\033[m\\n'\r"
      },
      {
        "checkpoint": "attributes"
      }
    ],
    "exit": "exit\r"
