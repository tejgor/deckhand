      "PS1": "$ ",
      "PS2": "> ",
      "TZ": "UTC",
      "BASH_SILENCE_DEPRECATION_WARNING": "1",
      "XDG_CONFIG_HOME": "$SANDBOX/home/.config",
      "XDG_STATE_HOME": "$SANDBOX/home/.local/state",
      "XDG_CACHE_HOME": "$SANDBOX/home/.cache",
