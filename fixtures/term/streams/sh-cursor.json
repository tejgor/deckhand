      "GIT_CONFIG_NOSYSTEM": "1"
    },
    "steps": [
      {
        "send": "printf '\\033[2J\\033[H0123456789\\033[3;5Habc\\033[2Aup\\033[3Bdown\\033[4Cright\\033[2Dleft\\033[20Gcol20\\033[8dvpa8\\n'\r"
      },
      {
        "checkpoint": "moves"
      },
      {
        "send": "printf 'erase-me-to-the-end\\033[9D\\033[K|\\nerase-the-start\\033[6D\\033[1K|\\nwhole-line\\033[2K|\\n'\r"
      },
      {
        "checkpoint": "erase-line"
      },
      {
        "send": "printf '\\033[5;1Hfill\\033[5;3H\\033[J'; printf '\\033[2;10H\\033[1J\\n'\r"
      },
      {
        "checkpoint": "erase-display"
      },
      {
        "send": "printf '\\033[2J\\033[H'; i=1; while [ $i -le 14 ]; do printf 'row %s\\n' $i; i=$((i+1)); done; printf '\\033[3;8r\\033[8;1H'; i=1; while [ $i -le 4 ]; do printf '\\nregion %s' $i; i=$((i+1)); done; printf '\\033[3;1H\\033M\\033Mrev\\033[r\\033[15;1H'\r"
      },
      {
        "checkpoint": "scroll-region"
      },
      {
        "send": "printf 'a\\tb\\tc\\td\\te\\tf\\tg\\th\\n12345678\\t9\\n\\033[3g\\033[5G\\033H\\033[1Gx\\ty\\ty\\n\\033[3g'\r"
      },
      {
        "checkpoint": "tabs"
      },
      {
        "send": "printf 'abcdefgh\\033[3D\\033[2@++\\033[2P\\033[3X\\n\\0337\\033[1;1HSAVED\\0338restored \\033[s\\033[2;1Hcsi-saved\\033[urestored-csi\\n'\r"
      },
      {
        "checkpoint": "edit-and-save"
      },
      {
        "send": "printf '\\033[2;1H\\033[3L\\033[6;1H\\033[2M'\r"
      },
      {
        "send": "clear\r"
      },
      {
        "checkpoint": "cleared"
      }
    ],
    "exit": "exit\r"
  }
