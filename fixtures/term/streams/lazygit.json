  "recording": {
    "command": "lazygit",
    "environment": {
      "HOME": "$SANDBOX/home",
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "TERM": "xterm-256color",
      "LANG": "en_US.UTF-8",
      "LC_ALL": "en_US.UTF-8",
      "SHELL": "/bin/sh",
      "PS1": "$ ",
      "PS2": "> ",
      "TZ": "UTC",
      "BASH_SILENCE_DEPRECATION_WARNING": "1",
      "XDG_CONFIG_HOME": "$SANDBOX/home/.config",
      "XDG_STATE_HOME": "$SANDBOX/home/.local/state",
      "XDG_CACHE_HOME": "$SANDBOX/home/.cache",
      "XDG_DATA_HOME": "$SANDBOX/home/.local/share",
      "GIT_CONFIG_GLOBAL": "/dev/null",
      "GIT_CONFIG_NOSYSTEM": "1",
      "LG_CONFIG_FILE": "$SANDBOX/home/.config/lazygit/config.yml"
    },
    "steps": [
      {
        "wait": 1500
      },
      {
        "checkpoint": "started"
      },
      {
        "send": "2"
      },
      {
        "send": "j"
      },
      {
        "checkpoint": "files"
      },
      {
        "send": "4"
      },
      {
        "send": "j"
      },
      {
        "send": "\r"
      },
      {
        "checkpoint": "commit-files"
      },
      {
        "send": "\u001b"
      },
      {
        "send": "?"
      },
      {
        "checkpoint": "keybindings"
      },
      {
        "send": "\u001b"
      },
      {
        "resize": [
          80,
          24
        ]
      },
      {
        "checkpoint": "resized"
      }
    ],
    "exit": "q"
  }
}
