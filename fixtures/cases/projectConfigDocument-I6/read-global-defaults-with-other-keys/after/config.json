{
  "dev_command": "legacy",
  "attach_scroll_sensitivity": 3,
  "trustedProjects": {
    "/repo": [
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    ]
  },
  "agent_hooks": true,
  "notifications": true,
  "custom_key": {
    "nested": [
      1,
      2
    ]
  },
  "defaults": {
    "defaultAgent": "claude",
    "defaultWorkspace": "new",
    "devCommand": "npm run dev",
    "actions": {
      "Test": "npm test"
    },
    "worktree": {
      "location": "~/wt/{name}",
      "symlink": [
        "node_modules"
      ],
      "branchFrom": "default",
      "hook": false
    }
  }
}
