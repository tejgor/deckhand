{
  "fn": "applyWorktreeLinks",
  "args": [
    {
      "symlink": [
        "a",
        "b",
        "c",
        "d"
      ],
      "files": {
        "x/y": "a",
        "x/z": "nope"
      }
    },
    {
      "launchRoot": "$ROOT/launch",
      "worktreeRoot": "$ROOT/wt",
      "vars": {
        "name": "feature x",
        "repo": "proj",
        "repoParent": "$ROOT",
        "repoRoot": "$ROOT/launch",
        "home": "$ROOT/home"
      }
    }
  ],
  "async": true,
  "ret": {
    "linked": [
      "a",
      "c",
      "x/y"
    ],
    "notes": [
      "b: exists and is not a symlink, kept",
      "d: source missing, skipped",
      "x/z: source missing, skipped"
    ]
  }
}
