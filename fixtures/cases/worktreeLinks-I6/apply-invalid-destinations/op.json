{
  "fn": "applyWorktreeLinks",
  "args": [
    {
      "symlink": [
        "",
        "..",
        "../x",
        "/abs",
        "a/../b",
        "./a",
        "a//b",
        "a/",
        ".git",
        ".git/config",
        "a\\b",
        "a\u0000b",
        "ok"
      ]
    },
    {
      "launchRoot": "$ROOT/launch",
      "worktreeRoot": "$ROOT/wt",
      "vars": {
        "name": "feature x",
        "repo": "proj",
        "repoParent": "$ROOT",
        "repoRoot": "$ROOT/launch",
        "home": "$ROOT/home"
      }
    }
  ],
  "async": true,
  "ret": {
    "linked": [
      "ok"
    ],
    "notes": [
      ": invalid destination",
      "..: invalid destination",
      "../x: invalid destination",
      "/abs: invalid destination",
      "a/../b: invalid destination",
      "./a: invalid destination",
      "a//b: invalid destination",
      "a/: invalid destination",
      ".git: invalid destination",
      ".git/config: invalid destination",
      "a\\b: invalid destination",
      "a\u0000b: invalid destination"
    ]
  }
}
