{
  "fn": "applyWorktreeLinks",
  "args": [
    {
      "symlink": [
        "missing",
        "present",
        "missing2"
      ]
    },
    {
      "launchRoot": "$ROOT/launch",
      "worktreeRoot": "$ROOT/wt",
      "vars": {
        "name": "feature x",
        "repo": "proj",
        "repoParent": "$ROOT",
        "repoRoot": "$ROOT/launch",
        "home": "$ROOT/home"
      }
    }
  ],
  "async": true,
  "ret": {
    "linked": [
      "present"
    ],
    "notes": [
      "missing: source missing, skipped",
      "missing2: source missing, skipped"
    ]
  }
}
